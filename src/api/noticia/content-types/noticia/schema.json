{
  "kind": "collectionType",
  "collectionName": "noticias",
  "info": { "singularName": "noticia", "pluralName": "noticias", "displayName": "Noticia" },
  "options": { "draftAndPublish": true },
  "attributes": {
    "titulo": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "titulo" },
    "resumo": { "type": "text", "maxLength": 500 },
    "conteudo": { "type": "richtext" },
    "imagem_capa": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "imagem_url": { "type": "string" },
    "video_url": { "type": "string" },
    "data_publicacao": { "type": "date", "required": true },
    "autor": { "type": "string", "default": "FUT LANCE" },
    "categoria": { "type": "relation", "relation": "manyToOne", "target": "api::categoria.categoria" }
  }
}