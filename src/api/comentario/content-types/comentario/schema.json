{
  "kind": "collectionType",
  "collectionName": "comentarios",
  "info": {
    "singularName": "comentario",
    "pluralName": "comentarios",
    "displayName": "Comentario"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nome": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email"
    },
    "texto": {
      "type": "text",
      "required": true
    },
    "data": {
      "type": "datetime",
      "default": "now"
    },
    "aprovado": {
      "type": "boolean",
      "default": false
    },
    "noticia": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::noticia.noticia"
    }
  }
}